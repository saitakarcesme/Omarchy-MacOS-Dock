{
  "name": "Omarchy-MacOS-Dock",
  "slug": "omarchy-macos-dock",
  "kind": "dock",
  "dependencies": [
    "quickshell",
    "hyprctl",
    "magick",
    "python3",
    "gtk-launch",
    "uwsm-app"
  ],
  "copies": [
    {
      "source": "dock",
      "destination": ".config/quickshell/classic-dock"
    }
  ],
  "lua": {
    ".config/hypr/autostart.lua": "o.launch_on_start(\"quickshell -n -p \" .. os.getenv(\"HOME\") .. \"/.config/quickshell/classic-dock\")",
    ".config/hypr/looknfeel.lua": "hl.layer_rule({ match = { namespace = \"^classic-dock(-popup)?$\" }, blur = true, blur_popups = true, ignore_alpha = 0.2, no_anim = true })"
  }
}
